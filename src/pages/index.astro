---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Jonathan Vidal - Software Engineer">
    
    <!-- Dynamic Glowing Grid Overlay -->
    <div class="fixed inset-0  z-[-1]">
        <!-- Subtle grain texture -->
        <div class="absolute inset-0 opacity-[0.03] dark:opacity-[0.06] mix-blend-overlay" style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 200 200%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noiseFilter%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.65%22 numOctaves=%223%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noiseFilter)%22/%3E%3C/svg%3E');"></div>
        <!-- ThreeJS Canvas -->
        <div id="threejs-canvas" class="absolute inset-0 opacity-40 dark:opacity-60"></div>
    </div>

    <!-- Navigation -->
    <nav class="fixed top-6 left-1/2 -translate-x-1/2 z-50 p-2 rounded-full bg-white/70 dark:bg-[#0a0a10]/70 backdrop-blur-xl border border-gray-200/50 dark:border-white/10 shadow-lg flex items-center gap-3 transition-all duration-500 w-[90%] md:w-auto justify-between md:justify-center">
        <!-- Logo -->
        <a href="#" class="font-bold tracking-widest uppercase text-xs hover:text-[#0052FF] transition-colors shrink-0 pl-4">KR0ZAPPS</a>
        
        <!-- Divider -->
        <div class="hidden md:block h-4 w-[1px] bg-gray-300 dark:bg-gray-700 mx-2"></div>
        
        <!-- Links (Segmented Control style) -->
        <div class="hidden md:flex items-center gap-1 text-sm font-medium shrink-0">
            <a href="#work" class="px-5 py-2 rounded-full text-gray-600 dark:text-gray-400 hover:text-[#1a1c1c] dark:hover:text-white hover:bg-black/5 dark:hover:bg-white/10 transition-all active:scale-95">Trabajo</a>
            <a href="#stack" class="px-5 py-2 rounded-full text-gray-600 dark:text-gray-400 hover:text-[#1a1c1c] dark:hover:text-white hover:bg-black/5 dark:hover:bg-white/10 transition-all active:scale-95">Ingeniería</a>
            <a href="#" class="px-5 py-2 rounded-full text-gray-600 dark:text-gray-400 hover:text-[#1a1c1c] dark:hover:text-white hover:bg-black/5 dark:hover:bg-white/10 transition-all active:scale-95">Sobre mí</a>
        </div>
        
        <!-- Divider -->
        <div class="hidden md:block h-4 w-[1px] bg-gray-300 dark:bg-gray-700 mx-2"></div>
        
        <!-- Theme Toggle & GitHub -->
        <a href="https://github.com/kr0zapps" target="_blank" class="text-gray-500 hover:text-[#1a1c1c] dark:text-gray-400 dark:hover:text-white transition-colors flex items-center justify-center p-2 rounded-full hover:bg-black/5 dark:hover:bg-white/10" title="Ver GitHub">
            <i data-lucide="github" class="w-4 h-4"></i>
        </a>
        <div class="h-4 w-[1px] bg-gray-300 dark:bg-gray-700 mx-1"></div>
        <button id="theme-toggle" class="relative w-14 h-8 rounded-full bg-gray-200 dark:bg-gray-800 border border-gray-300 dark:border-gray-700 focus:outline-none overflow-hidden flex items-center transition-colors shrink-0 mr-1 group">
            <div id="theme-slider" class="absolute left-1 w-6 h-6 rounded-full bg-white dark:bg-black shadow-sm flex items-center justify-center transition-transform duration-300 transform dark:translate-x-6 group-hover:scale-95">
                <i data-lucide="sun" class="w-3.5 h-3.5 text-orange-500 dark:opacity-0 transition-opacity absolute"></i>
                <i data-lucide="moon" class="w-3.5 h-3.5 text-blue-400 opacity-0 dark:opacity-100 transition-opacity absolute"></i>
            </div>
        </button>
    </nav>

    <!-- Hero Section -->
    <main class="relative min-h-[100svh] flex flex-col justify-center items-center px-6 pt-24 pb-12 overflow-hidden">
        <div class="w-full max-w-[90rem] mx-auto flex flex-col items-start relative z-10">
            
            <h1 class="scroll-reveal text-[clamp(4rem,9vw,11rem)] leading-[0.85] font-extrabold tracking-tighter text-[#1a1c1c] dark:text-white" style="transition-delay: 100ms;">
                SOLUCIONES<br/>
                <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#0052FF] to-blue-400 dark:from-white dark:to-gray-500">DIGITALES.</span>
            </h1>

            <div class="scroll-reveal mt-12 grid grid-cols-1 md:grid-cols-2 gap-12 w-full border-t border-gray-200 dark:border-white/10 pt-12" style="transition-delay: 200ms;">
                <p class="text-lg md:text-xl text-gray-600 dark:text-gray-400 max-w-xl font-medium leading-relaxed">
                    Soy Jonathan Vidal, titulado de Duoc UC. Me especializo en el desarrollo de Landing Pages optimizadas, Dashboards interactivos y aplicaciones web. Disfruto transformar problemas complejos en soluciones simples, rápidas y fáciles de usar.
                </p>
                <div class="flex flex-col sm:flex-row gap-4 sm:gap-6 md:justify-end items-start">
                    <a href="#work" class="group relative px-8 py-4 bg-[#1a1c1c] dark:bg-white text-white dark:text-[#1a1c1c] rounded-full font-bold tracking-wide overflow-hidden transition-all duration-300 hover:scale-105 active:scale-95 w-full sm:w-auto text-center hover:shadow-[0_0_40px_rgba(0,82,255,0.3)]">
                        <span class="relative z-10 flex items-center justify-center gap-2">Explorar Trabajo <i data-lucide="arrow-down" class="w-4 h-4 group-hover:translate-y-1 transition-transform"></i></span>
                    </a>
                    <a href="https://github.com/kr0zapps" target="_blank" class="group px-8 py-4 bg-white/50 dark:bg-white/5 border border-gray-200 dark:border-white/10 text-[#1a1c1c] dark:text-white rounded-full font-bold tracking-wide backdrop-blur-md hover:bg-gray-100 dark:hover:bg-white/10 transition-colors w-full sm:w-auto text-center">
                        <i data-lucide="github" class="w-4 h-4 inline-block mr-2 -mt-0.5"></i>Ver GitHub
                    </a>
                </div>
            </div>
        </div>
    </main>

    <!-- Work Section -->
    <section id="work" class="px-6 py-32 w-full max-w-[90rem] mx-auto flex flex-col gap-12">
        <div class="scroll-reveal flex flex-col gap-4 mb-8">
            <h2 class="text-5xl md:text-7xl font-extrabold tracking-tighter text-[#1a1c1c] dark:text-white">Proyectos Destacados</h2>
            <p class="text-xl text-gray-600 dark:text-gray-400 max-w-2xl">Lógica compleja destilada en experiencias visuales de alto nivel.</p>
        </div>

        <!-- 3D Perspective Wrapper -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 w-full perspective-[2000px]" id="cards-wrapper">
            
            <!-- CARD 1: FitGamer -->
            <div class="glow-card tilt-card scroll-reveal group relative rounded-3xl bg-white dark:bg-[#0a0a10] border border-gray-200 dark:border-white/10 overflow-hidden shadow-sm hover:shadow-2xl transition-all duration-300 flex flex-col min-h-[550px] transform-gpu">
                <div class="glow-overlay hidden dark:block"></div>
                <div class="p-8 md:p-10 relative z-10 flex flex-col h-full ">
                    <div class="flex justify-between items-start mb-4">
                        <div>
                            <h3 class="text-3xl font-bold tracking-tight text-[#1a1c1c] dark:text-white mb-2">FitGamer</h3>
                            <p class="text-gray-600 dark:text-gray-400 font-medium">Gamificación extrema para fitness</p>
                        </div>
                        <a href="https://play.google.com/store/apps/details?id=com.fitgamer.app&hl=es_CL" target="_blank" class="magnetic-btn w-12 h-12 rounded-full bg-gray-100 dark:bg-white/5 flex items-center justify-center border border-gray-200 dark:border-white/10 group-hover:bg-[#1a1c1c] group-hover:text-white dark:group-hover:bg-white dark:group-hover:text-black transition-colors duration-300 shrink-0 cursor-pointer">
                            <i data-lucide="arrow-up-right" class="w-5 h-5 transition-transform duration-300 group-hover:rotate-45"></i>
                        </a>
                    </div>
                    
                    <p class="text-sm text-gray-500 dark:text-gray-500 mb-6 max-w-sm leading-relaxed">
                        Aplicación nativa que transforma rutinas de ejercicio en misiones RPG, integrando métricas biométricas en tiempo real a través de HealthConnect.
                    </p>

                    <div class="flex gap-2 flex-wrap mb-8">
                        <span class="font-mono flex items-center gap-1.5 text-[10px] font-bold tracking-widest uppercase bg-gray-100 dark:bg-white/5 px-3 py-1.5 rounded-full border border-gray-200/50 dark:border-white/5 text-gray-800 dark:text-gray-300"><i class="devicon-kotlin-plain colored text-sm"></i>Kotlin</span>
                        <span class="font-mono flex items-center gap-1.5 text-[10px] font-bold tracking-widest uppercase bg-gray-100 dark:bg-white/5 px-3 py-1.5 rounded-full border border-gray-200/50 dark:border-white/5 text-gray-800 dark:text-gray-300"><i class="devicon-android-plain text-[#3DDC84] text-sm"></i>Compose</span>
                    </div>

                    <div class="relative w-full aspect-[4/3] mt-auto rounded-2xl overflow-hidden border border-gray-200 dark:border-white/10 bg-gray-50 dark:bg-black">
                        <div class="absolute inset-0 bg-[#0052FF]/20 opacity-0 group-hover:opacity-100 transition-opacity duration-500 z-10 flex items-center justify-center backdrop-blur-sm">
                            <a href="https://play.google.com/store/apps/details?id=com.fitgamer.app&hl=es_CL" target="_blank" class="px-6 py-3 bg-white text-black font-bold rounded-full transform translate-y-4 group-hover:translate-y-0 transition-all duration-500 shadow-xl hover:scale-105 active:scale-95">Ver Proyecto</a>
                        </div>
                        <img src="/portafolio/fitgamer-official.png" alt="FitGamer App" class="project-image w-full h-full object-cover object-top opacity-95 transition-transform duration-300 transform-gpu" />
                    </div>
                </div>
            </div>

            <!-- CARD 2: Cállate Spam -->
            <div class="glow-card tilt-card scroll-reveal group relative rounded-3xl bg-white dark:bg-[#0a0a10] border border-gray-200 dark:border-white/10 overflow-hidden shadow-sm hover:shadow-2xl transition-all duration-300 flex flex-col min-h-[550px] transform-gpu">
                <div class="glow-overlay hidden dark:block"></div>
                <div class="p-8 md:p-10 relative z-10 flex flex-col h-full ">
                    <div class="flex justify-between items-start mb-4">
                        <div>
                            <h3 class="text-3xl font-bold tracking-tight text-[#1a1c1c] dark:text-white mb-2">Cállate Spam</h3>
                            <p class="text-gray-600 dark:text-gray-400 font-medium">Filtro ML on-device para llamadas</p>
                        </div>
                        <div class="w-12 h-12 rounded-full bg-gray-100 dark:bg-white/5 flex items-center justify-center border border-gray-200 dark:border-white/10 text-gray-400 dark:text-gray-600 shrink-0 cursor-not-allowed opacity-60" title="Descontinuado"><i data-lucide="ban" class="w-5 h-5"></i></div>
                    </div>
                    
                    <p class="text-sm text-gray-500 dark:text-gray-500 mb-6 max-w-sm leading-relaxed">
                        Sistema telefónico impulsado por CoreML que analiza patrones de llamadas y bloquea spam en tiempo real sin comprometer la privacidad.
                    </p>

                    <div class="flex gap-2 flex-wrap mb-8">
                        <span class="font-mono flex items-center gap-1.5 text-[10px] font-bold tracking-widest uppercase bg-gray-100 dark:bg-white/5 px-3 py-1.5 rounded-full border border-gray-200/50 dark:border-white/5 text-gray-800 dark:text-gray-300"><i class="devicon-swift-plain text-[#F05138] text-sm"></i>Swift</span>
                        <span class="font-mono flex items-center gap-1.5 text-[10px] font-bold tracking-widest uppercase bg-gray-100 dark:bg-white/5 px-3 py-1.5 rounded-full border border-gray-200/50 dark:border-white/5 text-gray-800 dark:text-gray-300"><i class="devicon-apple-original dark:text-white text-sm"></i>CoreML</span>
                    </div>

                    <div class="relative w-full aspect-[4/3] mt-auto rounded-2xl overflow-hidden border border-gray-200 dark:border-white/10 bg-gray-50 dark:bg-[#111116]">
                        <div class="absolute inset-0 bg-[#0052FF]/20 opacity-0 group-hover:opacity-100 transition-opacity duration-500 z-10 flex items-center justify-center backdrop-blur-sm">
                            <span class="px-6 py-3 bg-red-500/90 text-white font-bold rounded-full transform translate-y-4 group-hover:translate-y-0 transition-all duration-500 shadow-xl cursor-not-allowed tracking-wide">Descontinuado</span>
                        </div>
                        <img src="/portafolio/callate-official.png" alt="Cállate Play Store" class="project-image w-full h-full object-contain p-2 md:p-6 opacity-95 transition-transform duration-300 transform-gpu" />
                    </div>
                </div>
            </div>

            <!-- CARD 3: Fénix Select -->
            <div class="glow-card tilt-card scroll-reveal group relative rounded-3xl bg-white dark:bg-[#0a0a10] border border-gray-200 dark:border-white/10 overflow-hidden shadow-sm hover:shadow-2xl transition-all duration-300 flex flex-col min-h-[550px] transform-gpu">
                <div class="glow-overlay hidden dark:block"></div>
                <div class="p-8 md:p-10 relative z-10 flex flex-col h-full ">
                    <div class="flex justify-between items-start mb-4">
                        <div>
                            <h3 class="text-3xl font-bold tracking-tight text-[#1a1c1c] dark:text-white mb-2">Fénix Select</h3>
                            <p class="text-gray-600 dark:text-gray-400 font-medium">E-Commerce Premium de Licores</p>
                        </div>
                        <a href="https://fenixselect.cl" target="_blank" class="magnetic-btn w-12 h-12 rounded-full bg-gray-100 dark:bg-white/5 flex items-center justify-center border border-gray-200 dark:border-white/10 group-hover:bg-[#1a1c1c] group-hover:text-white dark:group-hover:bg-white dark:group-hover:text-black transition-colors duration-300 shrink-0">
                            <i data-lucide="arrow-up-right" class="w-5 h-5 transition-transform duration-300 group-hover:rotate-45"></i>
                        </a>
                    </div>
                    
                    <p class="text-sm text-gray-500 dark:text-gray-500 mb-6 max-w-sm leading-relaxed">
                        Plataforma comercial brutalista con animaciones a 60fps, optimización radical de imágenes y arquitectura de UI basada en Offcanvas.
                    </p>

                    <div class="flex gap-2 flex-wrap mb-8">
                        <span class="font-mono flex items-center gap-1.5 text-[10px] font-bold tracking-widest uppercase bg-gray-100 dark:bg-white/5 px-3 py-1.5 rounded-full border border-gray-200/50 dark:border-white/5 text-gray-800 dark:text-gray-300"><i class="devicon-astro-plain text-[#1a1c1c] dark:text-white text-sm"></i>Astro</span>
                        <span class="font-mono flex items-center gap-1.5 text-[10px] font-bold tracking-widest uppercase bg-gray-100 dark:bg-white/5 px-3 py-1.5 rounded-full border border-gray-200/50 dark:border-white/5 text-gray-800 dark:text-gray-300"><i class="devicon-tailwindcss-plain colored text-sm"></i>Tailwind</span>
                    </div>

                    <div class="relative w-full aspect-[4/3] mt-auto rounded-2xl overflow-hidden border border-gray-200 dark:border-white/10 bg-gray-50 dark:bg-black">
                        <div class="absolute inset-0 bg-[#0052FF]/20 opacity-0 group-hover:opacity-100 transition-opacity duration-500 z-10 flex items-center justify-center backdrop-blur-sm ">
                            <a href="https://fenixselect.cl" target="_blank" class="px-6 py-3 bg-white text-black font-bold rounded-full transform translate-y-4 group-hover:translate-y-0 transition-all duration-500 shadow-xl hover:scale-105 active:scale-95 pointer-events-auto">Visitar Web</a>
                        </div>
                        <img src="/portafolio/fenix-official.png" alt="Fénix Select Web" class="project-image w-full h-full object-cover object-top opacity-95 transition-transform duration-300 transform-gpu" />
                    </div>
                </div>
            </div>

            <!-- CARD 4: Sistema RSVP -->
            <div class="glow-card tilt-card scroll-reveal group relative rounded-3xl bg-white dark:bg-[#0a0a10] border border-gray-200 dark:border-white/10 overflow-hidden shadow-sm hover:shadow-2xl transition-all duration-300 flex flex-col min-h-[550px] transform-gpu">
                <div class="glow-overlay hidden dark:block"></div>
                <div class="p-8 md:p-10 relative z-10 flex flex-col h-full ">
                    <div class="flex justify-between items-start mb-4">
                        <div>
                            <h3 class="text-3xl font-bold tracking-tight text-[#1a1c1c] dark:text-white mb-2">Sistema RSVP</h3>
                            <p class="text-gray-600 dark:text-gray-400 font-medium">Dashboard de eventos en tiempo real</p>
                        </div>
                        <div class="w-12 h-12 rounded-full bg-gray-100 dark:bg-white/5 flex items-center justify-center border border-gray-200 dark:border-white/10 text-gray-400 dark:text-gray-600 shrink-0 cursor-not-allowed opacity-60" title="Vista Previa"><i data-lucide="eye" class="w-5 h-5"></i></div>
                    </div>
                    
                    <p class="text-sm text-gray-500 dark:text-gray-500 mb-6 max-w-sm leading-relaxed">
                        Arquitectura serverless para alta concurrencia. Gestión de estado inmutable con React y suscripciones en tiempo real mediante Supabase.
                    </p>

                    <div class="flex gap-2 flex-wrap mb-8">
                        <span class="font-mono flex items-center gap-1.5 text-[10px] font-bold tracking-widest uppercase bg-gray-100 dark:bg-white/5 px-3 py-1.5 rounded-full border border-gray-200/50 dark:border-white/5 text-gray-800 dark:text-gray-300"><i class="devicon-react-original colored text-sm"></i>React</span>
                        <span class="font-mono flex items-center gap-1.5 text-[10px] font-bold tracking-widest uppercase bg-gray-100 dark:bg-white/5 px-3 py-1.5 rounded-full border border-gray-200/50 dark:border-white/5 text-gray-800 dark:text-gray-300"><i class="devicon-supabase-plain colored text-sm"></i>Supabase</span>
                    </div>

                    <div class="relative w-full aspect-[4/3] mt-auto rounded-2xl overflow-hidden border border-gray-200 dark:border-white/10 bg-gray-50 dark:bg-[#1f1b1b]">
                        <div class="absolute inset-0 bg-[#0052FF]/20 opacity-0 group-hover:opacity-100 transition-opacity duration-500 z-10 flex items-center justify-center backdrop-blur-sm">
                            <span class="px-6 py-3 bg-white/50 dark:bg-black/50 text-gray-600 dark:text-gray-300 backdrop-blur-md font-bold rounded-full transform translate-y-4 group-hover:translate-y-0 transition-all duration-500 shadow-xl cursor-not-allowed tracking-wide">Vista Previa</span>
                        </div>
                        <img src="/portafolio/rsvp-official.png" alt="Sistema RSVP App" class="project-image w-full h-full object-cover object-top opacity-95 transition-transform duration-300 transform-gpu" />
                    </div>
                </div>
            </div>

        </div>

        <!-- Archive List (RedNorte & CuentaApp) -->
        <div class="mt-20 w-full">
            <div class="scroll-reveal mb-8">
                <h3 class="text-3xl font-bold tracking-tight text-[#1a1c1c] dark:text-white mb-2">Otros Proyectos</h3>
                <p class="text-gray-600 dark:text-gray-400">Trabajos adicionales e integraciones de ecosistemas.</p>
            </div>

            <div class="w-full flex flex-col border-t border-gray-200 dark:border-white/10 scroll-reveal">
                
                <!-- Row 1: RedNorte -->
                <a href="#" class="group flex flex-col md:flex-row md:items-center justify-between py-6 border-b border-gray-200 dark:border-white/10 hover:bg-gray-50 dark:hover:bg-white/[0.05] transition-colors gap-6 px-4 cursor-pointer">
                    <div class="flex flex-col md:flex-row md:items-center gap-4 md:gap-8 w-full md:w-3/4">
                        <span class="font-mono text-xs font-bold text-gray-400 dark:text-gray-600 w-12 shrink-0">2026</span>
                        <div class="hidden md:block w-32 h-20 bg-gray-100 dark:bg-white/5 rounded-lg border border-gray-200 dark:border-white/10 flex items-center justify-center text-gray-300 dark:text-gray-700 group-hover:bg-[#0052FF]/10 transition-colors"><i data-lucide="activity" class="w-6 h-6 group-hover:text-[#0052FF] transition-colors"></i></div>
                        <div>
                            <div class="flex items-center gap-2">
                                <h4 class="text-xl font-bold text-[#1a1c1c] dark:text-white group-hover:text-[#0052FF] transition-colors">RedNorte (Clínica Inteligente)</h4>
                                <i data-lucide="arrow-up-right" class="w-4 h-4 text-gray-400 group-hover:text-[#0052FF] transition-colors"></i>
                            </div>
                            <p class="text-sm text-gray-600 dark:text-gray-400 mt-2 leading-relaxed">Sistema de agendamiento médico integral. Cuenta con reasignación automática de turnos mediante microservicios y notificaciones SMS automáticas.</p>
                        </div>
                    </div>
                    <div class="flex flex-wrap gap-2 md:w-1/4 md:justify-end shrink-0">
                        <span class="font-mono text-[10px] font-bold tracking-widest text-[#1a1c1c] dark:text-white bg-gray-100 dark:bg-white/5 border border-gray-200 dark:border-white/10 px-3 py-1 rounded-full">NODE.JS</span>
                        <span class="font-mono text-[10px] font-bold tracking-widest text-[#1a1c1c] dark:text-white bg-gray-100 dark:bg-white/5 border border-gray-200 dark:border-white/10 px-3 py-1 rounded-full">MYSQL</span>
                    </div>
                </a>

                <!-- Row 2: CuentaApp -->
                <a href="#" class="group flex flex-col md:flex-row md:items-center justify-between py-6 border-b border-gray-200 dark:border-white/10 hover:bg-gray-50 dark:hover:bg-white/[0.05] transition-colors gap-6 px-4 cursor-pointer">
                    <div class="flex flex-col md:flex-row md:items-center gap-4 md:gap-8 w-full md:w-3/4">
                        <span class="font-mono text-xs font-bold text-gray-400 dark:text-gray-600 w-12 shrink-0">2025</span>
                        <div class="hidden md:block w-32 h-20 bg-gray-100 dark:bg-white/5 rounded-lg border border-gray-200 dark:border-white/10 flex items-center justify-center text-gray-300 dark:text-gray-700 group-hover:bg-[#0052FF]/10 transition-colors"><i data-lucide="pie-chart" class="w-6 h-6 group-hover:text-[#0052FF] transition-colors"></i></div>
                        <div>
                            <div class="flex items-center gap-2">
                                <h4 class="text-xl font-bold text-[#1a1c1c] dark:text-white group-hover:text-[#0052FF] transition-colors">CuentaApp</h4>
                                <i data-lucide="arrow-up-right" class="w-4 h-4 text-gray-400 group-hover:text-[#0052FF] transition-colors"></i>
                            </div>
                            <p class="text-sm text-gray-600 dark:text-gray-400 mt-2 leading-relaxed">Plataforma financiera orientada a artesanos para contabilizar ganancias y gastos. Incluye dashboard con gráficos interactivos y sincronización en la nube.</p>
                        </div>
                    </div>
                    <div class="flex flex-wrap gap-2 md:w-1/4 md:justify-end shrink-0">
                        <span class="font-mono text-[10px] font-bold tracking-widest text-[#1a1c1c] dark:text-white bg-gray-100 dark:bg-white/5 border border-gray-200 dark:border-white/10 px-3 py-1 rounded-full">REACT</span>
                        <span class="font-mono text-[10px] font-bold tracking-widest text-[#1a1c1c] dark:text-white bg-gray-100 dark:bg-white/5 border border-gray-200 dark:border-white/10 px-3 py-1 rounded-full">FIREBASE</span>
                    </div>
                </a>

                <!-- Row 3: Landing Pages -->
                <a href="#" class="group flex flex-col md:flex-row md:items-center justify-between py-6 border-b border-gray-200 dark:border-white/10 hover:bg-gray-50 dark:hover:bg-white/[0.05] transition-colors gap-6 px-4 cursor-pointer">
                    <div class="flex flex-col md:flex-row md:items-center gap-4 md:gap-8 w-full md:w-3/4">
                        <span class="font-mono text-xs font-bold text-gray-400 dark:text-gray-600 w-12 shrink-0">2025</span>
