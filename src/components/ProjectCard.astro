---
import type { Project } from '../data/projects';
import { ExternalLink, Github, Smartphone } from 'lucide-astro';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<div class="glass-card rounded-2xl overflow-hidden group flex flex-col h-full relative" data-type={project.type}>
  <!-- Image Container -->
  <div class="relative w-full h-48 overflow-hidden bg-slate-900">
    <img 
      src={project.image} 
      alt={project.title} 
      class="w-full h-full object-cover opacity-80 group-hover:opacity-100 group-hover:scale-105 transition-all duration-500"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-surface to-transparent"></div>
    
    <!-- Platform Badge -->
    <div class="absolute top-4 right-4 px-3 py-1 bg-surface/80 backdrop-blur-md rounded-full border border-white/10 text-xs font-mono text-slate-300 flex items-center gap-1">
      {project.platform === 'Google Play' ? <Smartphone class="w-3 h-3 text-green-400" /> : null}
      {project.platform}
    </div>
  </div>

  <!-- Content -->
  <div class="p-6 flex flex-col flex-grow">
    <div class="flex items-center gap-2 mb-3">
      {project.badges.map(badge => (
        <span class="px-2 py-0.5 text-[10px] font-mono uppercase tracking-wider text-accent-primary bg-accent-primary/10 border border-accent-primary/20 rounded-full">
          {badge}
        </span>
      ))}
    </div>
    
    <h3 class="text-xl font-heading font-semibold text-white mb-2 group-hover:text-accent-primary transition-colors">
      {project.title}
    </h3>
    
    <p class="text-sm text-slate-400 mb-6 flex-grow leading-relaxed">
      {project.description}
    </p>

    <!-- Tech Stack -->
    <div class="flex flex-wrap gap-2 mb-6">
      {project.techStack.map(tech => (
        <span class="text-xs text-slate-500 bg-white/5 px-2 py-1 rounded-md border border-white/5">
          {tech}
        </span>
      ))}
    </div>

    <!-- Links -->
    <div class="flex items-center gap-4 mt-auto pt-4 border-t border-white/5">
      {project.link && (
        <a href={project.link} class="flex items-center gap-1.5 text-sm font-medium text-slate-300 hover:text-white transition-colors">
          <ExternalLink class="w-4 h-4" />
          <span>Visitar</span>
        </a>
      )}
      {project.github && (
        <a href={project.github} class="flex items-center gap-1.5 text-sm font-medium text-slate-300 hover:text-white transition-colors">
          <Github class="w-4 h-4" />
          <span>Código</span>
        </a>
      )}
    </div>
  </div>
</div>
