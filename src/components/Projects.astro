---
import { projects } from '../data/projects';
import ProjectCard from './ProjectCard.astro';
---

<section class="py-24 px-6 max-w-6xl mx-auto">
  <div class="mb-16">
    <h2 class="text-3xl md:text-4xl font-heading font-bold text-white mb-4 flex items-center gap-4">
      <span class="w-8 h-1px bg-accent-primary block"></span>
      Proyectos Destacados
    </h2>
    <p class="text-slate-400 max-w-2xl">
      Una selección de mis trabajos más representativos, desde aplicaciones móviles publicadas hasta plataformas web completas.
    </p>
  </div>

  <!-- Filters (UI Only - MVP logic) -->
  <div class="flex flex-wrap items-center gap-2 mb-12">
    <button class="px-4 py-2 text-sm font-medium rounded-full bg-accent-primary/20 text-accent-primary border border-accent-primary/50 transition-all">Todos</button>
    <button class="px-4 py-2 text-sm font-medium rounded-full bg-surface text-slate-400 border border-white/5 hover:border-white/20 transition-all">Mobile</button>
    <button class="px-4 py-2 text-sm font-medium rounded-full bg-surface text-slate-400 border border-white/5 hover:border-white/20 transition-all">Web</button>
    <button class="px-4 py-2 text-sm font-medium rounded-full bg-surface text-slate-400 border border-white/5 hover:border-white/20 transition-all">Fintech & Apps</button>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {projects.map(project => (
      <ProjectCard project={project} />
    ))}
  </div>
</section>
